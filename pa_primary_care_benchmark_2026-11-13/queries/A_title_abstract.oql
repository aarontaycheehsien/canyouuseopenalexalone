get works where date <= (2021-04-01) and title-abstract has ("exercis*" OR "jog*" OR ("physical*" and "activ*" within 2 words of each other) OR ("physical" and "fit*" within 2 words of each other) OR ("physically" and "fit*" within 2 words of each other) OR "aerobics" OR "swim*" OR "gym*" OR "sport*" OR "workout" OR "skip*" OR "calisthenics" OR "step count*" OR "e-exercise" OR "pace" OR "pedometer" OR "bicyc*" OR "cycling" OR ("social" and "prescrib*" within 1 words of each other) OR "parkrun" OR "couch to 5k" OR "danc*") and title-abstract has ("gp" OR "general practi*" OR "family practi*" OR ("community" and "health*" within 1 words of each other) OR "ccg" OR "pcn" OR "clinical commissioning group*" OR ("communit*" and "nurs*" within 2 words of each other) OR ("primary" and "nurs*" within 2 words of each other) OR ("general" and "physician" within 2 words of each other) OR ("famil*" and "physician" within 2 words of each other) OR ("primary" and "physician" within 2 words of each other) OR "care home" OR "primary care" OR "primary health care" OR "pcg" OR ("general" and "doctor" within 2 words of each other) OR ("famil*" and "doctor" within 2 words of each other) OR ("primary" and "doctor" within 2 words of each other) OR ("practi*" and "nurse" within 1 words of each other) OR ("general" and "physical therapist*" within 2 words of each other) OR ("general" and "physiotherapist*" within 2 words of each other) OR ("family" and "physical therapist*" within 2 words of each other) OR ("family" and "physiotherapist*" within 2 words of each other) OR ("primary" and "physical therapist*" within 2 words of each other) OR ("primary" and "physiotherapist*" within 2 words of each other) OR ("communit*" and "physical therapist*" within 2 words of each other) OR ("communit*" and "physiotherapist*" within 2 words of each other)) and title-abstract has (("quasi" and "rct" within 1 words of each other) OR ("quasi" and "randomi*ed controlled trial" within 1 words of each other) OR "randomi*ed" OR "placebo")
