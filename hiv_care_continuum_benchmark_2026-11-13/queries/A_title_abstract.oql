get works where date >= (2010-01-01) and date <= (2023-06-01) and title-abstract has ("hiv*" OR ((("human immun*" and "deficien*" within 1 words of each other)) AND (("deficien*" and "virus" within 1 words of each other))) OR ((("acquired" and "immun*" within 1 words of each other)) AND (("immun*" and "deficien*" within 1 words of each other)) AND (("deficien*" and "syndrome" within 1 words of each other)))) and title-abstract has (child OR "pediatric*" OR "paediatric*" OR "adolesc*" OR "teen*" OR ("young*" AND "adult*")) and title-abstract has (((continuum and care within 2 words of each other) OR ("continuum" and "health service*" within 2 words of each other) OR (continuity and care within 2 words of each other) OR ("continuity" and "health service*" within 2 words of each other) OR (cascade and care within 2 words of each other) OR ("cascade" and "health service*" within 2 words of each other) OR (standard and care within 2 words of each other) OR ("standard" and "health service*" within 2 words of each other) OR ("health" and "quality" within 2 words of each other) OR ("standard" and "care" within 2 words of each other) OR "refer*" OR ("health*" and "access*" within 2 words of each other) OR "consult*") OR (("hiv" and "point of care" within 1 words of each other) OR ("hiv" and "test*" within 1 words of each other) OR ("hiv" and "diag*" within 1 words of each other)) OR (("antiretrovir*" and "therap*" within 1 words of each other) OR ("antiretrovir*" and "treat*" within 1 words of each other) OR ("antiretrovir*" and "agent*" within 1 words of each other) OR ("anti retrovir*" and "therap*" within 1 words of each other) OR ("anti retrovir*" and "treat*" within 1 words of each other) OR ("anti retrovir*" and "agent*" within 1 words of each other) OR ("anti-retrovir*" and "therap*" within 1 words of each other) OR ("anti-retrovir*" and "treat*" within 1 words of each other) OR ("anti-retrovir*" and "agent*" within 1 words of each other)) OR ((care AND ("link*" OR "enrol*" OR "consult*" OR "access*" OR "engag*" OR "connect*" OR "enter*" OR entry OR entrance OR "initiat*" OR "integra*" OR "attend*")) OR ((treatment OR therapy) AND (rapid OR "same day" OR "fast track" OR universal OR "test and treat" OR "treat all" OR early OR "accelerat*" OR instant OR prompt OR fast OR quick OR "expedit*" OR immediate))) OR (care AND ("retain" OR "retention")) OR (((viral and load within 1 words of each other) OR (virus and load within 1 words of each other) OR ("virologic*" and "load" within 1 words of each other)) AND (("load" and "undetect*" within 2 words of each other) OR ("load" and "monitor*" within 2 words of each other) OR ("load" and "test*" within 2 words of each other) OR ("load" and "fail*" within 2 words of each other) OR ("load" and "resist*" within 2 words of each other) OR ("load" and "suppress*" within 2 words of each other) OR (load and success within 2 words of each other) OR (load and response within 2 words of each other) OR (load and level within 2 words of each other) OR (load and concentration within 2 words of each other) OR (load and sustain within 2 words of each other))) OR ("adheren*" OR "complian*")) and title-abstract has (angola OR botswana OR comoros OR eritrea OR eswatini OR swaziland OR ethiopia OR kenya OR lesotho OR madagascar OR malawi OR mauritius OR mozambique OR namibia OR rwanda OR seychelles OR "south africa" OR "south sudan" OR uganda OR tanzania OR zambia OR zimbabwe OR (("east*" OR "south*") AND africa))
