get works where date <= (2023-03-31) and language is [English](en) and (title-abstract has ("stroke*" OR "poststroke" OR "post-stroke" OR "hemipar*" OR "hemipleg*" OR "cerebrovascular" OR "paretic" OR "cerebrovascular accident*" OR "intracerebral hemorrhage" OR "intracerebral haemorrhage" OR ("cerebral" and "infarct*" within 2 words of each other) OR ("brain" and "infarct*" within 2 words of each other)) or keyword is [stroke](keywords/stroke) or keyword is [ischemic stroke](keywords/ischemic-stroke) or keyword is [stroke rehabilitation](keywords/stroke-rehabilitation) or keyword is [hemiparesis](keywords/hemiparesis) or keyword is [post-stroke hemiparesis](keywords/post-stroke-hemiparesis) or keyword is [upper limb hemiparesis](keywords/upper-limb-hemiparesis)) and (title-abstract has ("virtual reality" OR "virtual-reality" OR "virtual environment*" OR "virtual rehabilitation" OR "virtual training" OR "immersive" OR "semi-immersive" OR "non-immersive" OR "exergam*" OR "video gam*" OR "videogam*" OR "serious game*" OR "computer game*" OR "interactive game*" OR "gaming" OR "game-based" OR "kinect" OR "nintendo" OR "wii" OR "xbox" OR "playstation" OR "eyetoy" OR "leap motion" OR "head-mounted display*" OR "augmented reality" OR "mixed reality" OR "gamif*" OR "rehabilitation gaming system" OR "telerehabilitation" OR ("virtual" and "reality" within 2 words of each other) OR ("virtual" and "realities" within 2 words of each other) OR ("video" and "game*" within 2 words of each other)) or keyword is [virtual reality](keywords/virtual-reality) or keyword is [immersive virtual reality](keywords/immersive-virtual-reality) or keyword is [virtual reality simulation](keywords/virtual-reality-simulation) or keyword is [exergames](keywords/exergames) or keyword is [virtual reality exergames](keywords/virtual-reality-exergames) or keyword is [video games](keywords/video-games)) and (title-abstract has ("random*" OR "rct" OR "rcts" OR "controlled trial*" OR "controlled clinical trial*" OR "control group*" OR "controlled study" OR "clinical trial*" OR "pilot trial*" OR "feasibility trial*" OR "single-blind*" OR "double-blind*" OR "assessor-blind*" OR "sham") or keyword is [randomized controlled trials](keywords/randomized-controlled-trials) or keyword is [pragmatic randomized controlled trial](keywords/pragmatic-randomized-controlled-trial))
