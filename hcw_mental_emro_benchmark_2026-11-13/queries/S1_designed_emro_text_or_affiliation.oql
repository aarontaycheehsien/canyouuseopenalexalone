get works where date >= (2020-01-01) and date <= (2024-08-04) and (title-abstract has ("covid*" OR "coronavirus*" OR "sars-cov-2" OR "sars cov 2" OR "2019-ncov" OR "ncov" OR "pandemic*") or keyword is [COVID-19 pandemic](keywords/covid-19) or keyword is [COVID-19 pandemic impact](keywords/covid-19-pandemic-impact)) and (title-abstract has ("health care worker*" OR "healthcare worker*" OR "health-care worker*" OR "health worker*" OR "health professional*" OR "healthcare professional*" OR "health care professional*" OR "health personnel" OR "healthcare personnel" OR "medical staff" OR "hospital staff" OR "health staff" OR "medical worker*" OR "frontline" OR "front-line" OR "nurse*" OR "nursing" OR "doctor*" OR "physician*" OR "resident*" OR "midwi*" OR "pharmacist*" OR "dentist*" OR "paramedic*" OR "clinician*" OR "surgeon*" OR "anesthesiologist*" OR "anaesthetist*" OR "intern*" OR "medical students") or keyword is [healthcare workers](keywords/healthcare-workers) or keyword is [nurses](keywords/nurses) or keyword is [registered nurses](keywords/registered-nurses) or keyword is [physician burnout](keywords/physician-burnout)) and (title-abstract has ("mental health" OR "psycholog*" OR "psychiatric" OR "anxi*" OR "depress*" OR "stress*" OR "ptsd" OR "posttraumatic" OR "post-traumatic" OR "burnout" OR "burn-out" OR "distress*" OR "insomnia" OR "sleep quality" OR "sleep disturbance*" OR "fear*" OR "emotional exhaustion" OR "resilien*" OR "wellbeing" OR "well-being" OR "suicid*" OR "obsessive") or keyword is [mental health](keywords/mental-health) or keyword is [anxiety](keywords/anxiety) or keyword is [depression](keywords/depression) or keyword is [stress](keywords/stress) or keyword is [burnout](keywords/burnout) or keyword is [psychological distress](keywords/psychological-distress)) and (title-abstract has ("afghan*" OR "bahrain*" OR "djibouti*" OR "egypt*" OR "iran" OR "iranian*" OR "iraq*" OR "jordan*" OR "kuwait*" OR "lebanon" OR "lebanese" OR "libya*" OR "morocc*" OR "oman" OR "omani*" OR "pakistan*" OR "palestin*" OR "gaza" OR "west bank" OR "qatar*" OR "saudi*" OR "somali*" OR "sudan*" OR "syria*" OR "tunisia*" OR "united arab emirates" OR "uae" OR "emirati*" OR "yemen*" OR "eastern mediterranean" OR "middle east*" OR "arab*" OR "gulf cooperation" OR "gcc" OR "mena" OR "emro" OR "tehran" OR "shiraz" OR "mashhad" OR "isfahan" OR "tabriz" OR "riyadh" OR "jeddah" OR "dammam" OR "mecca" OR "makkah" OR "medina" OR "madinah" OR "cairo" OR "alexandria" OR "karachi" OR "lahore" OR "islamabad" OR "peshawar" OR "rawalpindi" OR "amman" OR "beirut" OR "doha" OR "muscat" OR "dubai" OR "abu dhabi" OR "baghdad" OR "kabul" OR "khartoum" OR "tunis" OR "rabat" OR "casablanca" OR "sanaa" OR "mogadishu" OR "damascus" OR "benghazi" OR "tripoli" OR "kuwait city" OR "manama") or institution country is ([Afghanistan](countries/AF) or [Bahrain](countries/BH) or [Djibouti](countries/DJ) or [Egypt](countries/EG) or [Iran](countries/IR) or [Iraq](countries/IQ) or [Jordan](countries/JO) or [Kuwait](countries/KW) or [Lebanon](countries/LB) or [Libya](countries/LY) or [Morocco](countries/MA) or [Oman](countries/OM) or [Pakistan](countries/PK) or [Palestine](countries/PS) or [Qatar](countries/QA) or [Saudi Arabia](countries/SA) or [Somalia](countries/SO) or [Sudan](countries/SD) or [Syria](countries/SY) or [Tunisia](countries/TN) or [United Arab Emirates](countries/AE) or [Yemen](countries/YE)))
