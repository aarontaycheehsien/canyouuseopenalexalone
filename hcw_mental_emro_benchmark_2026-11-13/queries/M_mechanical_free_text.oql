get works where date >= (2020-01-01) and date <= (2024-08-04) and title-abstract-keywords has ("covid-19" OR "covid19" OR "coronavirus" OR "sars-cov-2" OR "coronavirus disease-19") and title-abstract-keywords has ("health care worker*" OR "healthcare personnel*" OR "medical staff*" OR "nurse*" OR "doctor*" OR "physician*") and title-abstract-keywords has ("mental health" OR "psychological impact" OR "anxiety" OR "depress*" OR "stress" OR "ptsd")
