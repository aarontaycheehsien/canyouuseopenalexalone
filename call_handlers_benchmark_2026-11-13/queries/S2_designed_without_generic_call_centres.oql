get works where date <= (2024-01-07) and language is ([English](en) or [French](fr) or [Spanish](es) or [Italian](it) or [Portuguese](pt)) and (title-abstract has ("call handl*" OR "call-handl*" OR "call taker*" OR "call-taker*" OR "dispatcher*" OR "telecommunicator*" OR "emergency call*" OR "emergency communication*" OR "public safety telecommunicat*" OR "public safety answering" OR "emergency operator*" OR "control room*" OR "999 call*" OR "112 call*" OR "911 call*" OR ("dispatch*" and "emergenc*" within 3 words of each other) OR ("dispatch*" and "ambulance*" within 3 words of each other) OR ("dispatch*" and "police" within 3 words of each other) OR ("dispatch*" and "fire" within 3 words of each other) OR ("dispatch*" and "911" within 3 words of each other) OR ("dispatch*" and "medical" within 3 words of each other) OR ("dispatch*" and "rescue" within 3 words of each other)) or keyword is [emergency medical dispatch](keywords/emergency-medical-dispatch) or keyword is [dispatchers](keywords/dispatchers)) and (title-abstract has ("mental health" OR "psycholog*" OR "psychiatric" OR "anxi*" OR "depress*" OR "stress*" OR "ptsd" OR "posttraumatic" OR "post-traumatic" OR "trauma*" OR "burnout" OR "burn-out" OR "distress*" OR "wellbeing" OR "well-being" OR "resilien*" OR "emotional exhaustion" OR "compassion fatigue" OR "secondary traumatic" OR "vicarious" OR "alcohol*" OR "hazardous drinking" OR "substance use" OR "sleep*" OR "suicid*" OR ("post trauma*" and "growth" within 2 words of each other) OR ("posttraumatic" and "growth" within 2 words of each other)) or keyword is [mental health](keywords/mental-health) or keyword is [anxiety](keywords/anxiety) or keyword is [depression](keywords/depression) or keyword is [stress](keywords/stress) or keyword is [burnout](keywords/burnout) or keyword is [psychological distress](keywords/psychological-distress))
