get works (all corpora) where date <= (2019-08-23) and title-abstract-keywords has ((maize OR corn OR (stemmed "Zea mays")) AND (field OR plot OR location OR trial OR (stemmed "farm scale") OR scouting OR trap OR trapping OR sampling OR monitoring) AND (transgenic OR Bt OR (stemmed "Bacillus thuringiensis") OR GM OR (stemmed "genetically modified") OR (stemmed "genetically engineered") OR "Cry*" OR "Vip*"))
