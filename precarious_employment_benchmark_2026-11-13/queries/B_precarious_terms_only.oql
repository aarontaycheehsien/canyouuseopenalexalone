get works where date <= (2019-03-31) and title-abstract has (precarity OR precariat OR (stemmed "precarious employment") OR (stemmed "precarious work") OR (stemmed "employment security") OR (stemmed "employment insecurity") OR (stemmed "secure employment") OR (stemmed "insecure employment") OR (stemmed "job security") OR (stemmed "job insecurity") OR (stemmed "low pay no pay cycle") OR "flexible labo*r" OR "dual labo*r" OR (stemmed "temporary employment") OR "temporary contract*" OR "zero hour contract*" OR (stemmed "gig economy") OR "contingent work*" OR (stemmed "contingent employment") OR "secondary labo*r market" OR flexicurity OR (stemmed "non-standard work") OR (stemmed "non-standard employment") OR "non-standard contract*" OR underemployment OR (stemmed "atypical work") OR "casual work*" OR (stemmed "casual employment") OR "casual labo*r" OR "non-permanent employ*" OR "non-permanent work*" OR (stemmed "exclusionary employment") OR "employment history*" OR "employment trajectory*" OR "employment transition*" OR "job transition*" OR "job separation*" OR "job trajector*")
