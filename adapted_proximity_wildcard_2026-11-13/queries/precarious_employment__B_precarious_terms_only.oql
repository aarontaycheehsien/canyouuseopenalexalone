get works where date <= (2019-03-31) and title-abstract has ("precar*" OR "precariat*" OR ("precari*" and "employ*" within 2 words of each other) OR ("precari*" and "work" within 2 words of each other) OR ("employ*" and "secur*" within 2 words of each other) OR ("employ*" and "insecur*" within 2 words of each other) OR ("secur*" and "employ*" within 2 words of each other) OR ("insecur*" and "employ*" within 2 words of each other) OR ("job" and "secur*" within 2 words of each other) OR ("job" and "insecur*" within 2 words of each other) OR (stemmed "low pay no pay cycle") OR "flexible labo*r" OR "dual labo*r" OR ("temporar*" and "employ*" within 2 words of each other) OR "temporary contract*" OR "zero hour contract*" OR ("gig" and "econom*" within 2 words of each other) OR "contingent work*" OR ("conting*" and "employ*" within 2 words of each other) OR "secondary labo*r market" OR "flexicur*" OR ("non-standard" and "work" within 2 words of each other) OR ("non-standard" and "employ*" within 2 words of each other) OR "non-standard contract*" OR "underemploy*" OR ("atypical" and "work" within 2 words of each other) OR "casual work*" OR ("casual*" and "employ*" within 2 words of each other) OR "casual labo*r" OR "non-permanent employ*" OR "non-permanent work*" OR ("exclusionar*" and "employ*" within 2 words of each other) OR "employment history*" OR "employment trajectory*" OR "employment transition*" OR "job transition*" OR "job separation*" OR "job trajector*")
