get works where date >= (2000-01-01) and date <= (2021-04-08) and title has ("student*" OR "pupil*" OR "child*" OR "youth*" OR "young*") and title has ("need*" OR "special*" OR "additional*") and title-abstract has ("integrat*" OR "immers*" OR "inclus*" OR "mainstream*" OR "placement*") and title-abstract has ("effect*" OR "trial*" OR "experiment*" OR "control*" OR "random*" OR "impact*" OR "compar*" OR "difference*")
