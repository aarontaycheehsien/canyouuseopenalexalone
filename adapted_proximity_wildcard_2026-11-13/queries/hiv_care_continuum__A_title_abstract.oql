e AND ("link*" OR "enrol*" OR "consult*" OR "access*" OR "engag*" OR "connect*" OR "enter*" OR entry OR "entranc*" OR "initiat*" OR "integra*" OR "attend*")) OR (("treatment*" OR "therap*") AND ("rapid*" OR ("same" and "day" within 2 words of each other) OR ("fast" and "track*" within 2 words of each other) OR "univers*" OR "test and treat" OR ("treat*" and "all" within 2 words of each other) OR early OR "accelerat*" OR "instant*" OR "prompt*" OR fast OR "quick*" OR "expedit*" OR "immedi*"))) OR (care AND ("retain*" OR "retent*")) OR ((("viral*" and "load" within 1 words of each other) OR ("virus" and "load" within 1 words of each other) OR ("virologic*" and "load" within 1 words of each other)) AND (("load" and "undetect*" within 2 words of each other) OR ("load" and "monitor*" within 2 words of each other) OR ("load" and "test*" within 2 words of each other) OR ("load" and "fail*" within 2 words of each other) OR ("load" and "resist*" within 2 words of each other) OR ("load" and "suppress*" within 2 words of each other) OR ("load" and "success*" within 2 words of each other) OR ("load" and "respons*" within 2 words of each other) OR ("load" and "level*" within 2 words of each other) OR ("load" and "concentr*" within 2 words of each other) OR ("load" and "sustain*" within 2 words of each other))) OR ("adheren*" OR "complian*")) and title-abstract has ("angola*" OR "botswana*" OR "comoro*" OR "eritrea*" OR "eswatini*" OR "swaziland*" OR "ethiopia*" OR "kenya*" OR "lesotho*" OR "madagascar*" OR "malawi*" OR "mauritiu*" OR "mozambiqu*" OR "namibia*" OR "rwanda*" OR "seychel*" OR ("south*" and "africa*" within 2 words of each other) OR ("south*" and "sudan*" within 2 words of each other) OR "uganda*" OR "tanzania*" OR "zambia*" OR "zimbabw*" OR (("east*" OR "south*") AND "africa*"))
