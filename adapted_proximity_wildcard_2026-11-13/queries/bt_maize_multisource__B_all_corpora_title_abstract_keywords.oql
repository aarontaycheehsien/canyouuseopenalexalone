get works (all corpora) where date <= (2019-08-23) and title-abstract-keywords has ((maize OR corn OR ("zea" and "mays" within 2 words of each other)) AND ("field*" OR plot OR "locat*" OR "trial*" OR ("farm" and "scale*" within 2 words of each other) OR "scout*" OR trap OR trapping OR "sampl*" OR "monitor*") AND ("transgen*" OR Bt OR ("bacillu*" and "thuringiensi*" within 2 words of each other) OR GM OR ("genet*" and "modifi*" within 2 words of each other) OR ("genet*" and "engin*" within 2 words of each other) OR "Cry*" OR "Vip*"))
