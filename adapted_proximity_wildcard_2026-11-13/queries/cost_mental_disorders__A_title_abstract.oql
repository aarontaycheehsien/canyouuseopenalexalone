get works where date >= (1980-01-01) and date <= (2019-06-30) and title-abstract has ((("cost of illness" OR "cost-of-illness" OR ("cost" and "burden*" within 2 words of each other) OR ("spend*" and "burden*" within 2 words of each other) OR ("illness" and "burden*" within 2 words of each other) OR "burden of illness" OR ("econom*" and "burden*" within 2 words of each other) OR ("econom*" and "impact*" within 2 words of each other) OR ("cost" and "analysi*" within 2 words of each other) OR ("cost" and "descript*" within 2 words of each other) OR "disease cost*" OR "cost of disease" OR "sickness cost*" OR "cost of sickness" OR "health expenditure*" OR "health care cost*") AND (("mood disorder*" OR "depress*" OR "MDD" OR "dysthymi*" OR "cyclothymi*" OR "bipolar*" OR "BP" OR "mania*" OR "manic*" OR "affective disorder*") OR ("dement*" OR "Alzheimer*" OR "organic disorder*") OR ("alcohol*" OR "depend*" OR "misus*" OR ("abuse" NOT ("child*" OR "children*" OR ("sexual*" and "abuse" within 2 words of each other))) OR "addict*" OR "drug*" OR "substanc*" OR "SUD" OR "SUDs" OR "opioid*" OR "heroin*" OR "morphin*" OR "cocain*" OR "marijuana*" OR "cannabi*" OR "hashish*" OR "amphetamin*" OR "methamphetamin*" OR "sedative" OR "tobacco*" OR "smoking" OR "nicotin*" OR "hallucinogen*" OR "stimulant*" OR "ecstas*" OR "MDMA" OR "LSD" OR ("substance-related" and "disord*" within 2 words of each other) OR ("substance-related" and "disord*" within 2 words of each other) OR "alcohol related disorder" OR ("cannabis-related" and "disord*" within 2 words of each other) OR ("amphetamine-related" and "disord*" within 2 words of each other) OR ("cocaine-related" and "disord*" within 2 words of each other) OR ("opioid-related" and "disord*" within 2 words of each other)) OR ("schizophreni*" OR "schizoaffective*" OR ("schizotypal*" AND "psychotic*") OR "psychotic disorder*" OR "delusional disorder*") OR ("anxiet*" OR "anxiety disorder*" OR "agoraphobia*" OR "generalized anxiety disorder*" OR "GAD" OR "obsessive compulsive disorder*" OR "OCD" OR "panic disorder*" OR "posttraumatic stress*" OR "post traumatic stress*" OR "PTSD" OR "social phobia*" OR "specific phobia*" OR "neurotic disorder*" OR "adjustment disorder*" OR "acute stress disorder*" OR "acute stress reaction" OR "dissociative disorder*" OR "neurotic disorder*") OR ("anorexia*" OR "bulimi*" OR ("eating" and "disord*" within 2 words of each other) OR ("eating" and "disord*" within 2 words of each other) OR "binge eat*" OR "binge eating disorder" OR "binge eating disorders") OR ("personality disorder*" OR "paranoid personality disorder" OR "paranoid personality disorders" OR "schizoid personality disorder" OR "schizoid personality disorders" OR "antisocial personality disorder" OR "antisocial personality disorders" OR "borderline personality disorder" OR "borderline personality disorders" OR "BPD" OR "histrionic personality disorder" OR "histrionic personality disorders" OR "obsessive-compulsive personality disorder" OR "obsessive-compulsive personality disorders" OR "avoidant personality disorder" OR "avoidant personality disorders" OR "dependent personality disorder" OR "dependent personality disorders" OR "narcissistic personality disorder" OR "narcissistic personality disorders" OR "habit and impulse disorder" OR "habit and impulse disorders") OR ("intellectual disability*" OR "mental retardation*" OR "autis*" OR "asperger*" OR "pervasive developmental disorder" OR "pervasive developmental disorders" OR "autism spectrum disorder" OR "autism spectrum disorders" OR "ASD") OR ("attention deficit disorder" OR "ADD" OR "attention deficit disorders" OR "ADHD" OR "attention deficit hyperactivity disorder" OR "attention deficit disorder with hyperactivity" OR ("conduct*" and "disord*" within 2 words of each other) OR ("conduct*" and "disord*" within 2 words of each other) OR "separation anxiety disorder" OR "separation anxiety disorders" OR "separation anxiety disorder, childhood" OR ("tic" and "disord*" within 2 words of each other) OR ("tic" and "disord*" within 2 words of each other) OR "oppositional defiant disorder" OR "oppositional defiant disorders" OR "ODD"))) NOT ("animal*" OR "trial*"))
