get works where date >= (2000-01-01) and date <= (2021-04-08) and ((it has an abstract and title-abstract-keywords has ((("student*" OR "pupil*" OR "child*" OR "youth*" OR "young*") AND ("need*" OR "special*" OR "additional*")) OR (stemmed "special needs students") OR (stemmed "children with disabilities") OR (stemmed "disabled child") OR (stemmed "disabled children") OR (stemmed "handicapped child") OR (stemmed "handicapped children") OR (stemmed "exceptional children") OR (stemmed "learning disabilities") OR (stemmed "developmental academic disorder") OR (stemmed "adolescent learning disabilities") OR (stemmed "adult learning disabilities") OR (stemmed "adult learning disorders") OR (stemmed "child learning disabilities") OR (stemmed "developmental academic disability") OR (stemmed "developmental disabilities of scholastic skills") OR (stemmed "developmental disorders of scholastic skills") OR (stemmed "learning disorders") OR (stemmed "learning disturbance") OR (stemmed "scholastic skills development disorders") OR (stemmed "developmental disabilities") OR (stemmed "child development deviations") OR (stemmed "specific child development disorders") OR (stemmed "child development disorders") OR (stemmed "developmental delay disorders")) and (title-abstract-keywords has (("integrat*" OR "immers*" OR "inclus*" OR "mainstream*" OR "placement*") OR (stemmed "school grade placement") OR (stemmed "inclusive education") OR (stemmed "mainstreaming in special education") OR (stemmed "academic accommodations") OR inclusion OR mainstreaming OR (stemmed "student placement") OR (stemmed "ability grouping") OR (stemmed "track system") OR (stemmed "child placement") OR (stemmed "special education")) or keyword is [grade placement](keywords/grade-placement) or keyword is [special education teachers](keywords/special-education-teachers)) and title-abstract-keywords has (("effect*" OR "trial*" OR "experiment*" OR "control*" OR "random*" OR "impact*" OR "compar*" OR "difference*") OR (stemmed "effect sizes") OR (stemmed "effect size") OR (stemmed "control groups") OR (stemmed "experimental groups") OR experiments OR (stemmed "research design") OR (stemmed "data adjustment") OR (stemmed "data reporting") OR (stemmed "experimental design") OR (stemmed "experimental designs") OR (stemmed "error sources") OR (stemmed "matched groups") OR (stemmed "research methodology") OR (stemmed "problem formulation") OR (stemmed "research proposal") OR (stemmed "research strategy") OR (stemmed "research technics") OR (stemmed "research techniques") OR (stemmed "scoring methods") OR (stemmed "quasiexperimental design") OR (stemmed "randomized controlled trials") OR (stemmed "comparative testing") OR (stemmed "clinical trials"))) or (it doesn't have an abstract and title-abstract-keywords has ((("student*" OR "pupil*" OR "child*" OR "youth*" OR "young*") AND ("need*" OR "special*" OR "additional*")) OR (stemmed "special needs students") OR (stemmed "children with disabilities") OR (stemmed "disabled child") OR (stemmed "disabled children") OR (stemmed "handicapped child") OR (stemmed "handicapped children") OR (stemmed "exceptional children") OR (stemmed "learning disabilities") OR (stemmed "developmental academic disorder") OR (stemmed "adolescent learning disabilities") OR (stemmed "adult learning disabilities") OR (stemmed "adult learning disorders") OR (stemmed "child learning disabilities") OR (stemmed "developmental academic disability") OR (stemmed "developmental disabilities of scholastic skills") OR (stemmed "developmental disorders of scholastic skills") OR (stemmed "learning disorders") OR (stemmed "learning disturbance") OR (stemmed "scholastic skills development disorders") OR (stemmed "developmental disabilities") OR (stemmed "child development deviations") OR (stemmed "specific child development disorders") OR (stemmed "child development disorders") OR (stemmed "developmental delay disorders")) and (title-abstract-keywords has (("integrat*" OR "immers*" OR "inclus*" OR "mainstream*" OR "placement*") OR (stemmed "school grade placement") OR (stemmed "inclusive education") OR (stemmed "mainstreaming in special education") OR (stemmed "academic accommodations") OR inclusion OR mainstreaming OR (stemmed "student placement") OR (stemmed "ability grouping") OR (stemmed "track system") OR (stemmed "child placement") OR (stemmed "special education")) or keyword is [grade placement](keywords/grade-placement) or keyword is [special education teachers](keywords/special-education-teachers))))
