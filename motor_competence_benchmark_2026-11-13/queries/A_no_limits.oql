get works where date <= (2023-06-27) and title-abstract-keywords has (("motor competenc*" OR (stemmed "motor skills") OR (stemmed "motor performance") OR (stemmed "motor proficiency") OR (stemmed "fundamental movement skills") OR (stemmed "fundamental motor skills") OR (stemmed "motor coordination") OR (stemmed "motor function") OR (stemmed "motor development") OR (stemmed "motor abilities") OR (stemmed "motor control") OR (stemmed "motor examination") OR (stemmed "motor milestones") OR "motor behavio*" OR (stemmed "gross motor skills") OR (stemmed "actual competence") OR (stemmed "object control") OR (stemmed "object manipulation") OR (stemmed "locomotor skill") OR stability OR balance OR (stemmed "postural control") OR (stemmed "stability skills") OR (stemmed "movement assessment battery")) AND ((stemmed "cognitive skills") OR (stemmed "cognitive performance") OR (stemmed "cognitive function") OR (stemmed "cognitive control") OR (stemmed "cognitive processes") OR cognition OR (stemmed "executive function") OR (stemmed "executive control") OR inhibition OR (stemmed "selective attention") OR (stemmed "interference control") OR (stemmed "working memory") OR (stemmed "cognitive flexibility") OR (stemmed "mental flexibility") OR (stemmed "task switching")) AND ("child*" OR "adolescen*" OR kindergarten OR "teen*" OR youth OR (stemmed "young people") OR (stemmed "young person") OR "student*"))
