get works where date <= (2023-06-03) and title-abstract-keywords has ((depress* OR dysthymi* OR "seasonal affective disorder") AND (sport* OR exercis* OR aerobic* OR running OR jogging OR walk* OR hiking OR swim* OR aquatic* OR yoga OR "tai-chi" OR "tai chi" OR "tai ji" OR qigong OR "qi gong" OR cycling OR bicycl* OR ((physical OR strength*) AND (activit* OR educat* OR fitness OR train*)) OR "physical medicine" OR ((resistance OR weight*) AND (train* OR lift*)) OR "physical exertion") AND (random* OR trial* OR groups OR control* OR placebo* OR factorial* OR crossover* OR (cross AND over*) OR ((singl* OR doubl* OR trebl* OR tripl*) AND (blind* OR mask* OR dummy)) OR assign* OR allocat* OR volunteer* OR "treatment effectiveness evaluation" OR "mental health program evaluation"))
